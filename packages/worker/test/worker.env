# Local integration tests only. Explicit envFiles prevents loading .dev.vars.
ENVIRONMENT=development
JWT_SECRET=eternalos-integration-test-only-not-a-production-secret
# Zero-day grace period so the account-purge test is immediately due after
# soft-delete, without waiting out the 14-day production window.
ACCOUNT_DELETION_GRACE_DAYS=0
# Tiny per-account daily AI budget (see middleware/aiUsage.ts) so the
# budget-exhaustion tests run in a handful of chat turns instead of the
# production default (200/day). Each AI-controls test signs up its own
# account, so the shared low ceiling cannot interfere with other suites.
AI_REQUESTS_PER_DAY=6
